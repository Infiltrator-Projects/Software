#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later

%:
	dh $@ --buildsystem=cmake --builddirectory=build-deb

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	ctest --test-dir build-deb --output-on-failure

override_dh_install:
	dh_install
	install -D -m 0644 debian/infiltrator-software.svg 		"$(CURDIR)/debian/infiltrator-software/usr/share/app-install/icons/infiltrator-software.svg"
